# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.28.0.schema.json

PackageIdentifier: TsubasaTommy.Optiman
PackageVersion: @VERSION@
InstallerType: inno
Scope: user
InstallModes:
- interactive
- silent
- silentWithProgress
# Installing the JPEG XL Image Extension runs winget from inside the installer, which waits for
# this very winget install to finish. Leave it to the settings window when installed by winget.
InstallerSwitches:
  Custom: /MERGETASKS="!jxlviewer"
UpgradeBehavior: install
ProductCode: '{60ADCF2D-2A75-4CF1-86E1-73921ECB571E}_is1'
ReleaseDate: @DATE@
Installers:
- Architecture: x64
  InstallerUrl: https://github.com/TsubasaTommy/optiman/releases/download/v@VERSION@/Optiman-Setup.exe
  InstallerSha256: @SHA256_SETUP@
- Architecture: arm64
  InstallerUrl: https://github.com/TsubasaTommy/optiman/releases/download/v@VERSION@/Optiman-Setup.exe
  InstallerSha256: @SHA256_SETUP@
ManifestType: installer
ManifestVersion: 1.28.0
